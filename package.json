{
  "name": "poc-playwright",
  "version": "1.0.0",
  "description": "Playwright automation testing project with Page Object Model pattern",
  "main": "index.js",
  "type": "module",
  "bin": {
    "playwright-ai-validator": "./bin/playwright-ai-validator.js"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:login": "playwright test tests/login.spec.ts",
    "test:update-user": "playwright test tests/update-user-info.spec.ts",
    "test:update-user:headed": "playwright test tests/update-user-info.spec.ts --headed --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:chrome": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:a11y": "playwright test --grep @a11y",
    "test:demo": "playwright test --grep @demo",
    "validate:test": "node --loader ts-node/esm src/cli.ts",
    "validate:test:build": "tsc && node dist/cli.js"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "pom",
    "ai-validator",
    "llm"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.2",
    "@types/uuid": "^10.0.0",
    "ai": "^6.0.78",
    "dotenv": "^17.2.4",
    "fs-extra": "^11.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^6.3.1",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0"
  }
}
