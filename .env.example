# Playwright AI Validator Configuration
# Copy this file to .env and fill in your values

# ===================================================================
# Gemini API Configuration
# ===================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Use Google AI API key
# GOOGLE_API_KEY=your_google_api_key_here

# Model to use for analysis
# Options: gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Temperature for AI responses (0.0 - 2.0)
# Lower = more deterministic, Higher = more creative
GEMINI_TEMPERATURE=0.2

# Maximum tokens for AI responses
GEMINI_MAX_TOKENS=8192

# ===================================================================
# Validation Configuration
# ===================================================================
# Confidence threshold for considering a test as PASSED (0.0 - 1.0)
VALIDATOR_CONFIDENCE_THRESHOLD=0.75

# Weight for visual analysis (0.0 - 1.0)
VALIDATOR_VISUAL_WEIGHT=0.5

# Weight for code analysis (0.0 - 1.0)
VALIDATOR_CODE_WEIGHT=0.5

# ===================================================================
# Loop Configuration
# ===================================================================
# Maximum number of fix iterations to attempt
VALIDATOR_MAX_ITERATIONS=5

# Test timeout in milliseconds
VALIDATOR_TEST_TIMEOUT=60000

# Delay between iterations in milliseconds
VALIDATOR_RETRY_DELAY=2000

# ===================================================================
# Output Configuration
# ===================================================================
# Output format: console, json, html
VALIDATOR_OUTPUT_FORMAT=console

# Save artifacts (screenshots, videos, traces)
VALIDATOR_SAVE_ARTIFACTS=true

# Path to save artifacts
VALIDATOR_ARTIFACT_PATH=ai-validator-artifacts

# ===================================================================
# Playwright Configuration
# ===================================================================
# Run tests in headed mode (useful for debugging)
PLAYWRIGHT_HEADED=false

# Slow motion delay in milliseconds (for debugging)
PLAYWRIGHT_SLOW_MO=0

# ===================================================================
# Self-Healing Test Agent Configuration
# ===================================================================
# Maximum iterations for goal-driven tests
AGENT_MAX_ITERATIONS=20

# Timeout per action (milliseconds)
AGENT_ACTION_TIMEOUT=30000

# Enable debug mode (saves screenshots, detailed logging)
AGENT_DEBUG=false

# Agent output directory
AGENT_OUTPUT_DIR=./test-results/agent

# Gemini model for agent
# Options: gemini-1.5-flash (fast with vision), gemini-1.5-pro (best reasoning)
AGENT_GEMINI_MODEL=gemini-1.5-flash
